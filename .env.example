# ─────────────────────────────────────────────────────────────
# ALEX DESIGN STUDIO OS — Environment Variables
# Copy this file to .env for local development
# ─────────────────────────────────────────────────────────────

# Output directory for generated campaign files (default: ./outputs)
ALEX_OUTPUT_DIR=./outputs

# (Optional) PostgreSQL connection string — only needed if using
# the PostgresJobStore instead of the default SQLite store.
# Format: postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://user:password@localhost:5432/alex_os

# Python version hint (used by some cloud platforms)
PYTHON_VERSION=3.12.8
